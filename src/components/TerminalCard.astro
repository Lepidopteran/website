---
import { Icon } from 'astro-icon/components';
const { class: className, ...rest } = Astro.props;
---

<div class:list={['rounded-lg', 'rounded-lg', 'border', 'border-neutral-600', 'relative', 'inline-block', 'font-jetbrains', 'overflow-hidden', className]} {...rest}>
  <div class="flex bg-neutral-900 border-b border-black px-4">
    <div class="flex items-center">
      <Icon name="ph:terminal" class="text-neutral-400" />
      <h4 class="text-neutral-400 font-bold text-base ml-2">
        <slot name="title">
          Terminal
        </slot>
      </h4>
    </div>
  </div>
  <div class="from-neutral-800 to-neutral-900 bg-gradient-to-b font-bold flex justify-center p-2 items-center">
    <slot name="body">
      Insert Body
    </slot>
  </div>
</div>
