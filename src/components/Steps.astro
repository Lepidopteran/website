<ol class="steps" role="list">
	<slot />
</ol>
<style is:global>
	ol.steps {
		--step-bubble-size: 1.5em;
		--step-bubble-color: rgb(from var(--color-neutral-700) r g b / 0.5);
		--step-bubble-connector-color: rgb(
			from var(--color-primary-300) r g b / 0.25
		);
		--step-margin: 2em;
		list-style-type: none;
		counter-reset: step-counter;

		& li.step {
			counter-increment: step-counter;
			padding-left: 3em;
			position: relative;

			&:not(:last-child) {
				margin-bottom: var(--step-margin);
			}

			&:first-child::before {
				border-top-style: solid;
			}

			&:last-child::before {
				border-bottom-style: solid;
			}

			&::before {
				position: absolute;
				left: 0;
				z-index: 1;
				content: counter(step-counter);
				color: #fff;
				background: var(--step-bubble-color);
				border: 1px solid rgb(from var(--color-neutral-50) r g b / 0.2);
				backdrop-filter: blur(3px);
				border-bottom-style: none;
				border-top-style: none;
				width: var(--step-bubble-size);
				height: var(--step-bubble-size);
				border-radius: 50%;
				box-shadow:
					0 0 8px 0 rgb(from var(--color-black) r g b / 0.2),
					inset 0 0 8px 0 rgb(from var(--color-black) r g b / 0.2);
				display: inline-block;
				text-align: center;
				line-height: 1.5em;
			}

			&:not(:last-child)::after {
				position: absolute;
				top: 0;
				z-index: 0;
				left: calc(var(--step-bubble-size) / 2);
				content: "";
				height: calc(100% + var(--step-margin));
				width: 0.2em;
				border-top: none;
				border-bottom: none;
				background: var(--step-bubble-connector-color);
				box-shadow:
					0 0 8px 0 rgb(from var(--color-black) r g b / 0.5),
					inset 0 0 1px 1px rgb(from var(--color-black) r g b / 0.25),
					inset 0 0 0 1px rgb(from var(--color-neutral-50) r g b / 0.1);
				transform: translateX(-50%);
			}
		}
	}
</style>
