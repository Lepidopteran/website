---
import { Icon } from "astro-icon/components";
import NoJavascriptSection from "./NoJavascriptSection.astro";
import { getCachedHighlighter } from "../lib/shiki";
import InteractiveCodeBlock from "./InteractiveCodeBlock.svelte";
import { bundledLanguages } from "shiki";

import { transformerColorizedBrackets } from "@shikijs/colorized-brackets";
import {
	transformerNotationDiff,
	transformerNotationWordHighlight,
	transformerNotationHighlight,
	transformerNotationFocus,
	transformerNotationErrorLevel,
} from "@shikijs/transformers";

import type {
	BundledLanguage,
	LanguageRegistration,
	ShikiTransformer,
	SpecialLanguage,
} from "shiki";

import type { CodeSnippet, ShikiCodeSnippet } from "../lib/code";

export interface Props {
	lang?: BundledLanguage | SpecialLanguage | LanguageRegistration;
	noJavascriptNamePrefix?: string;
	noJavascriptNameSuffix?: string;
	transformers?: ShikiTransformer[];
	code: string | CodeSnippet[];
}

const {
	lang,
	code,
	noJavascriptNamePrefix = "",
	noJavascriptNameSuffix = "",
	transformers = [
		transformerColorizedBrackets(),
		transformerNotationHighlight(),
		transformerNotationFocus(),
		transformerNotationWordHighlight(),
		transformerNotationDiff(),
		transformerNotationErrorLevel(),
	],
}: Props = Astro.props;

const highlighter = await getCachedHighlighter({
	langs: [
		typeof lang === "string"
			? Object.keys(bundledLanguages).includes(lang)
				? lang
				: "plaintext"
			: (lang as any),
	],
	theme: "kanagawa-wave",
});

const defaultAttributes: Record<string, string> = {
	style: "overflow-x: auto; overflow-y: hidden; padding: .5rem 0;",
};

const snippets: ShikiCodeSnippet[] = [];
const language: string | undefined =
	typeof lang === "string" ? lang : lang?.name;

if (typeof code === "string" && lang) {
	snippets.push({
		snippet: code,
		html: await highlighter.codeToHtml(code, language, {
			transformers,
			attributes: { ...defaultAttributes },
		}),
	});
} else if (Array.isArray(code)) {
	for (const snippet of code) {
		snippets.push({
			...snippet,
			html: await highlighter.codeToHtml(
				snippet.snippet,
				snippet.language || language,
				{
					transformers,
					attributes: { ...defaultAttributes },
				},
			),
		});
	}
}
---

<NoJavascriptSection>
	{
		snippets.map((snippet, index) => (
			<div class="mb-4">
				{snippets.length > 1 && (
					<h4 class="font-semibold">
						{`${noJavascriptNamePrefix}${snippet.name || `Snippet ${index + 1}`}${noJavascriptNameSuffix}`}
					</h4>
				)}
				<div class="flex justify-between items-center inset-shadow-sm inset-shadow-neutral-700/75 shadow-md border border-b-0 border-black/25 shadow-black/25 rounded-t-lg">
					<div class="py-0.5 px-2 flex items-center text-neutral-500">
						<div class="px-1">
							{snippet.language || language || "plaintext"}
						</div>
					</div>
				</div>
				<div
					class="relative rounded-b-lg border border-t-0 border-black/25 overflow-hidden"
					set:html={snippet.html}
				/>
			</div>
		))
	}
</NoJavascriptSection>

<div class="no-js-hidden">
	<InteractiveCodeBlock lang={lang} code={snippets} client:load />
</div>

<style is:global>
	code .line {
		display: inline-block;
		min-width: 100%;
		padding: 0 0.5rem;
	}
</style>
