---
import { Icon } from "astro-icon/components";

const { icon, name, size, iconClassName, link } = Astro.props;
---
{link ? (
  <a href={link} class="flex flex-col p-4 gap-2 items-center text-nowrap" target="_blank" rel="noopener noreferrer">
    <Icon name={icon} size={size} class={iconClassName} />
    <p class="text-nowrap">{name}</p>
  </a>
) : (
  <div class="flex flex-col p-4 gap-2 items-center text-nowrap">
    <Icon name={icon} size={size} class={iconClassName} />
    <p class="text-nowrap">{name}</p>
  </div>
)}
