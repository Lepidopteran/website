---
const { class: className, ...rest } = Astro.props;
---

<div class:list={["inline-block", "size-16", "relative", className]} {...rest}>
	<div class="absolute bottom-0 flex w-full justify-center">
		<div class="flex w-1/2 justify-evenly">
			<div class="bg-white bottom-4 skew-x-8 smoke" style="--delay: 2s"></div>
			<div class="bg-white bottom-10 skew-x-8 smoke" style="--delay: 3s"></div>
			<div class="bg-white bottom-6 skew-x-8 smoke" style="--delay: 1s"></div>
		</div>
	</div>
  <svg
    clip-rule="evenodd"
    fill-rule="evenodd"
    stroke-linejoin="round"
    stroke-miterlimit="2"
    version="1.1"
    viewBox="0 0 1001 1310"
    xml:space="preserve"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
  >
    <defs>
      <linearGradient
        id="linearGradient24"
        x1=".14798"
        x2=".94814"
        y1=".031717"
        y2=".038406"
        gradientTransform="matrix(2.0987 496.99 -250.76 2.2866 508.06 838.28)"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#fff" offset="0"></stop>
        <stop stop-color="#867059" offset="1"></stop>
      </linearGradient>
      <linearGradient
        id="linearGradient25"
        x2="1"
        gradientTransform="matrix(1.4195 212.04 -136.98 .91703 822.72 854.54)"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#ffc45d" offset="0"></stop>
        <stop stop-color="#d9b964" offset="1"></stop>
      </linearGradient>
      <filter id="nnnoise-filter">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.5"
          seed="1"
          stitchTiles="stitch"
          result="turbulence"></feTurbulence>
        <feSpecularLighting
          in="turbulence"
          surfaceScale="10"
          specularConstant="1"
          specularExponent="5"
          lighting-color="#111"
          result="coloredNoise"
        >
          <feDistantLight azimuth="3" elevation="122"></feDistantLight>
        </feSpecularLighting>
        <feComposite
          in="SourceGraphic"
          in2="coloredNoise"
          operator="out"
          result="monoNoise"></feComposite>
      </filter>
    </defs>
    <g id="Bowl-Of-Soup" filter="url(#nnnoise-filter)">
      <g
        clip-rule="evenodd"
        fill-rule="evenodd"
        stroke-linejoin="round"
        stroke-miterlimit="2"
      >
        <path
          id="Bowl"
          d="m94.73 911.9h811.38c4.537 149.34-67.026 312.32-202.82 397.68h-405.74c-135.79-85.37-207.36-248.35-202.82-397.68z"
          fill="url(#linearGradient24)"></path>
        <path
          id="Soup"
          d="m398.64 911.89s146.61 45.385 218.5 60.477c19.484 4.09 41.449 16.078 47.112 31.424 21.291 57.68-44.416 183.58 3.0829 182.29 55.593-1.5215 5.261-121.16 48.603-196.93 8.438-14.75 31.809-31.674 43.725-42.886 26.591-25.02 64.472-34.378 64.472-34.378z"
          fill="url(#linearGradient25)"></path>
      </g>
    </g>
  </svg>
</div>
<style>
  .smoke {
    transform-origin: center;
    animation: smoke 10s ease-in-out infinite;
    animation-delay: var(--delay);
		position: relative;
		width: 0.125rem;
		height: 3rem;
    filter: blur(1rem);
  }

  @keyframes smoke {
    0%,
    100% {
      --tw-scale-y: 1;
      --tw-scale-x: 1;
      opacity: 100%;
    }

    50% {
      --tw-scale-y: 0.9;
      --tw-scale-x: 0.9;
      opacity: 25%;
    }
  }
</style>
