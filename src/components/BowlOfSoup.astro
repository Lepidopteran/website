<style>
  .smoke {
    transform-origin: center;
    animation: smoke 10s ease-in-out infinite;
    animation-delay: var(--delay);
    filter: blur(100px);
  }

  @keyframes smoke {
    0%,
    100% {
      opacity: 100%;
      transform: scale(1);
    }

    50% {
      transform: scale(0.9);
      opacity: 25%;
    }
  }
</style>
