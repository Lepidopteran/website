---
import '@fontsource/inter';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono';
import '@fontsource/oswald';
import '@fontsource/red-hat-display';
import '@fontsource-variable/red-hat-display';
import { Icon } from 'astro-icon/components';
export interface Props {
	title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear()

---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script src="../components/Gallery.ts"></script>
		<script src="../components/Card.ts"></script>
	</head>
	<body class="min-h-svh box-border overflow-y-auto overflow-x-hidden bg-neutral-800">
		<div class="absolute h-full w-full overflow-hidden top-0 left-0 z-0">
			<slot name="background" />
		</div>
		<header class="flex items-center justify-center col-start-2 col-end-3 row-start-1 sticky top-0 md:top-1 z-10 transition-all h-16">
			<nav class="flex bg-neutral-900/80 px-6 rounded-xl max-md:rounded-t-none items-center gap-4 max-w-screen-2xl w-full shadow-inner shadow-white/5 backdrop-blur-xl border border-t-0 border-neutral-600 border-opacity-50 box-border h-full md:mx-1 transition-all">
				<a href="/">Home</a>
				<a href="/projects">Projects</a>
			</nav> 
		</header>
		<main class="h-full col-start-2 col-end-3 m-auto pt-3 justify-self-stretch relative max-w-6xl container">
			<slot  />
		</main>
		<footer class="bg-neutral-800/50 border-t flex justify-center border-white/25 p-3 pt-10 mt-8 shadow-[rgba(0,0,15,0.5)_-1.5rem_0_2rem] relative z-10">
			<div class="max-w-6xl m-auto w-full">
				<div class="grid gap-2 grid-cols-2 md:grid-cols-3 items-baseline justify-start">
					<div class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 rounded-xl flex flex-col grow gap-2 col-span-2 md:col-span-1 shadow-lg shadow-black/35 border-t">
						<h4 class="text-lg pl-2 text-neutral-50/75 font-bold">Contact</h4>
						<input type="text" name="name" class="bg-transparent w-full text-neutral-50 p-2 border-t border-white/25 rounded-md shadow-md shadow-neutral-900" placeholder="Name" />
						<input type="email" name="email" class="bg-transparent w-full text-neutral-50 p-2 border-t border-white/25 rounded-md shadow-md shadow-neutral-900" placeholder="Email" />
						<input type="text" name="subject" class="bg-transparent w-full text-neutral-50 p-2 border-t border-white/25 rounded-md shadow-md shadow-neutral-900" placeholder="Subject" />
						<textarea name="message" class="bg-transparent w-full h-24 text-neutral-50 border-white/25 border-t p-2 rounded-md shadow-md shadow-neutral-900" placeholder="Message"></textarea>
						<button class="bg-emerald-800 text-neutral-50 hover:bg-emerald-600 shadow-md transition w-full p-2 rounded-md border-t border-white/25">Send</button>
					</div>	
					<div class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 rounded-xl shadow-lg shadow-black/35 border-t">
						<h4 class="text-neutral-50/75 font-bold">Socials</h4>	
						<ul class="mt-1">
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center py-1">
									<Icon class="inline mr-2" name="simple-icons:instagram" />
									Instagram
								</a>
							</li>
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center gap-1 py-1">
									<Icon class="inline mr-2" name="simple-icons:twitter" />
									Twitter
								</a>
							</li>
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center gap-1 py-1">
									<Icon class="inline mr-2" name="simple-icons:github" />
									GitHub
								</a>
							</li>
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center gap-1 py-1">
									<Icon class="inline mr-2" name="simple-icons:linkedin" />
									LinkedIn
								</a>
							</li>
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center gap-1 py-1">
									<Icon class="inline mr-2" name="simple-icons:youtube" />
									YouTube
								</a>
							</li>
							<li>
								<a href="" class="text-neutral-50 hover:text-blue-600 flex items-center gap-1 py-1">
									<Icon class="inline mr-2" name="simple-icons:mastodon" />
									Mastodon
								</a>
							</li>
						</ul>
					</div>
					<div>

						<div class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 rounded-xl shadow-lg shadow-black/35 border-t">
							<h4 class="text-neutral-50/75 font-bold">Resources</h4>	
							<ul class="mt-1">
								<li>
									<a href="" class="text-neutral-50 hover:text-blue-600 py-1">
										Home
									</a>
								</li>
								<li>
									<a href="" class="text-neutral-50 hover:text-blue-600 py-1">
										Projects
									</a>
								</li>
								<li>
									<a href="" class="text-neutral-50 hover:text-blue-600 py-1">
										Privacy Policy
									</a>
								</li>
								<li>
									<a href="" class="text-neutral-50 hover:text-blue-600 py-1">
										Terms of Service
									</a>
								</li>
						</div>
						<!-- <a href="https://ko-fi.com/blainenicholls" class="text-neutral-950 bg-yellow-400 backdrop-blur hover:bg-yellow-400/50 px-3 py-1.5 mt-3 block rounded-lg shadow-lg shadow-yellow-700/25 font-bold border-t border-white/25"> -->
						<!-- 	Support Me ❤  -->
						<!-- </a> -->
					</div>
				</div>
				<div class="text-sm opacity-50 mt-3">
					&copy; Copyright by Blaine Nicholls {currentYear.toString()}   
				</div>
			</div>
		</footer>
	</body>
</html>
<style is:global>
	:root {
		--accent: 124, 58, 237;
		--shadow-color: hsla(0,0%,0%,0.3);
		--text-color: #f4f4f5;
		--color-border: hsla(0, 0%, 50%, 0.5);
	}

	html {
		font-family: system-ui, sans-serif;
		background-color: #18181b;
		color: var(--text-color);
		color-scheme: dark;
	}

	body {
		margin: 0;
		position: relative;
	}

	.layout {
		display: grid;
		grid-template-columns: auto 1fr auto;
	}


	.header {
		background-color: #111;
		grid-column: 1/-1;
		border-bottom-left-radius: 1em;
		border-bottom-right-radius: 1em;
		padding-inline: 1em
	}

	.header__nav {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: end;
	}

	.header__nav--right-block {
		margin-left: auto;
	}

	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
</style>
