---
import "@fontsource/inter";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono";
import "@fontsource/oswald";
import "@fontsource/red-hat-display";
import "@fontsource-variable/red-hat-display";
import { Icon } from "astro-icon/components";
import "../styles/global.css";

export interface Props {
	title: string;
	stickyHeader?: boolean;
}

const { title, stickyHeader } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body
		class="min-h-svh box-border overflow-y-auto overflow-x-hidden bg-neutral-800"
	>
		<input
			type="checkbox"
			id="mobileMenuToggle"
			class="hidden"
			aria-hidden="true"
		/>
		<style is:global>
			#mobileMenuToggle:checked {
				& ~ header {
					& > div:first-child {
						border-bottom-right-radius: 0;
					}

					& #mobileMenuToggleLabel > svg {
						transform: rotate(180deg);
					}

					& #mobileMenu {
						display: block;
					}
				}
			}

			@media screen and (width < 80rem) {
				#mobileMenuToggle:checked {
					& ~ header {
						& > div:first-child {
							border-bottom-left-radius: 0;
						}
					}
				}
			}
		</style>
		<div class="absolute h-full w-full overflow-hidden top-0 left-0 z-0">
			<slot name="background" />
		</div>
		<header
			class={`grid xl:justify-center items-center w-full md:px-2 top-0 md:top-1 z-10 transition-all h-14 ${stickyHeader === false ? "relative" : "sticky"}`}
		>
			<div
				id="mainHeaderContainer"
				class="flex justify-between bg-neutral-900/80 px-4 rounded-xl max-md:rounded-t-none items-center gap-4 max-w-screen-2xl w-full xl:w-[75svw] shadow-inner shadow-white/5 backdrop-blur-xl border border-t-0 border-neutral-600/50 box-border py-2 md:m-auto transition"
			>
				<a class="flex gap-3 items-center relative" href="/">
					<span class="font-redhat text-lg whitespace-nowrap"
						>Blaine Nicholls</span
					>
				</a>
				<nav
					class="flex gap-4 bg-primary-800/15 shadow-inner shadow-primary-500/25 px-4 py-2 rounded-full items-center"
				>
					<a
						href="/"
						class={Astro.url.pathname === "/"
							? "text-primary-300"
							: "text-neutral-300"}
					>
						Home
					</a>
					<label
						id="mobileMenuToggleLabel"
						class={`${
							Astro.url.pathname === "/projects"
								? "text-primary-300"
								: "text-neutral-300"
						} cursor-pointer select-none`}
						for="mobileMenuToggle"
					>
						Projects
						<Icon
							name="mingcute:down-line"
							class="inline group-hover:rotate-180 group-checked/mobileMenu:rotate-180 transition-transform"
						/>
					</label>
				</nav>
			</div>
			<div
				id="mobileMenu"
				class="hidden bg-neutral-950/80 rounded-xl rounded-t-none shadow-inner shadow-white/5 backdrop-blur-xl border border-t-0 border-neutral-600/50 box-border transition-all xl:justify-self-end"
			>
				<ul>
					<li>
						<a href="/nett-icon-viewer" class="link block py-2 px-4">
							<img
								class="w-6 inline mr-1"
								src="/projects/nett-icon-viewer/logo.svg"
								alt="Nett Icon Viewer Logo"
							/>
							Nett Icon Viewer</a
						>
					</li>
				</ul>
				<hr class="text-neutral-600/50" />
				<a href="/projects" class="link block px-4 py-2 font-bold"
					>All Projects <Icon
						name="mingcute:arrow-right-line"
						class="ml-1 inline"
					/></a
				>
			</div>
		</header>
		<main
			class="h-full col-start-2 col-end-3 m-auto pt-3 justify-self-stretch relative max-w-6xl container"
		>
			<slot />
		</main>
		<footer
			class="bg-neutral-900 border-t flex justify-center border-white/25 p-3 pt-10 mt-8 shadow-[rgba(0,0,15,0.5)_-1.5rem_0_2rem] relative z-[5]"
		>
			<div class="max-w-5xl m-auto w-full">
				<div class="grid gap-2 grid-cols-[2fr_1fr] items-start justify-start">
					<form
						name="contact"
						method="POST"
						data-netlify="true"
						class="col-span-2 md:col-span-1"
					>
						<div
							class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 rounded-xl flex flex-col grow gap-2 shadow-lg shadow-black/35 border-t"
						>
							<h4 class="text-lg pl-2 text-neutral-50/75 font-bold">Contact</h4>
							<input
								type="text"
								name="name"
								class="bg-neutral-900/50 w-full text-neutral-50 p-2 rounded-md inset-shadow-sm inset-shadow-neutral-950/75"
								placeholder="Name"
							/>
							<input
								type="email"
								name="email"
								class="bg-neutral-900/50 w-full text-neutral-50 p-2 rounded-md inset-shadow-sm inset-shadow-neutral-950/75"
								placeholder="Email"
							/>
							<input
								type="text"
								name="subject"
								class="bg-neutral-900/50 w-full text-neutral-50 p-2 rounded-md inset-shadow-sm inset-shadow-neutral-950/75"
								placeholder="Subject"
							/>
							<textarea
								name="message"
								class="bg-neutral-900/50 w-full h-24 text-neutral-50 p-2 rounded-md inset-shadow-sm inset-shadow-neutral-950/75"
								placeholder="Message"></textarea>
							<button type="submit" class="btn btn-primary">Send</button>
						</div>
					</form>
					<div
						class="flex flex-col grow gap-2 size-full col-span-2 md:col-span-1"
					>
						<div
							class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 w-full rounded-xl shadow-lg shadow-black/35 border-t"
						>
							<h4 class="text-neutral-50/75 font-bold">Resources</h4>
							<ul>
								<li>
									<a href="/" class="link py-1"> Home </a>
								</li>
								<li>
									<a href="/projects" class="link py-1"> Projects </a>
								</li>
								<li>
									<a href="/certifications" class="link py-1"> Certificates </a>
								</li>
								<!-- TODO: Add legal stuff -->
								<!-- <li> -->
								<!-- 	<a href="" class="link py-1"> -->
								<!-- 		Privacy Policy -->
								<!-- 	</a> -->
								<!-- </li> -->
								<!-- <li> -->
								<!-- 	<a href="" class="link py-1"> -->
								<!-- 		Terms of Service -->
								<!-- 	</a> -->
								<!-- </li> -->
							</ul>
						</div>
						<div
							class="border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-800/50 p-3 pt-2 rounded-xl grow shadow-lg shadow-black/35 border-t"
						>
							<h4 class="text-neutral-50/75 font-bold">Socials</h4>
							<ul>
								<li>
									<a
										href="https://github.com/Lepidopteran"
										class="link flex items-center gap-1"
									>
										<Icon class="inline mr-2" name="simple-icons:github" />
										GitHub
									</a>
								</li>
								<li>
									<a
										href="https://www.linkedin.com/in/blaine-nicholls-42b78a312"
										class="link flex items-center gap-1"
									>
										<Icon class="inline mr-2" name="simple-icons:linkedin" />
										LinkedIn
									</a>
								</li>
								<li>
									<a
										href="https://www.youtube.com/@blainecodes"
										class="link flex items-center gap-1"
									>
										<Icon class="inline mr-2" name="simple-icons:youtube" />
										YouTube
									</a>
								</li>
								<li>
									<a
										href="https://mastodon.social/@blainenicholls"
										class="link flex items-center gap-1"
									>
										<Icon class="inline mr-2" name="simple-icons:mastodon" />
										Mastodon
									</a>
								</li>
							</ul>
						</div>
						<a
							href="https://ko-fi.com/blainenicholls"
							class="btn btn-secondary"
						>
							Buy me a coffee
						</a>
					</div>
					<div class="text-sm opacity-50 mt-3">
						&copy; Copyright by Blaine Nicholls {new Date().getFullYear().toString()}
					</div>
				</div>
			</div>
		</footer>
		<style is:global>
			:root {
				--accent: 124, 58, 237;
				--shadow-color: hsla(0, 0%, 0%, 0.3);
				--text-color: #f4f4f5;
				--color-border: hsla(0, 0%, 50%, 0.5);
			}

			html {
				font-family: system-ui, sans-serif;
				background-color: #18181b;
				color: var(--text-color);
				color-scheme: dark;
			}

			body {
				margin: 0;
				position: relative;
			}

			.layout {
				display: grid;
				grid-template-columns: auto 1fr auto;
			}

			.header {
				background-color: #111;
				grid-column: 1/-1;
				border-bottom-left-radius: 1em;
				border-bottom-right-radius: 1em;
				padding-inline: 1em;
			}

			.header__nav {
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: end;
			}

			.header__nav--right-block {
				margin-left: auto;
			}

			code {
				font-family:
					Menlo,
					Monaco,
					Lucida Console,
					Liberation Mono,
					DejaVu Sans Mono,
					Bitstream Vera Sans Mono,
					Courier New,
					monospace;
			}
		</style>

		<noscript>
			<style>
				.no-js-hidden {
					display: none;
				}

				.no-js-invisible {
					visibility: hidden;
				}
			</style>
		</noscript>
	</body>
</html>
