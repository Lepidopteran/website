---
import { getCollection } from "astro:content";
import Projects from "../projects.astro";
import ProjectModal from "../../components/ProjectModal.svelte";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;

const visible = data.sourceCode || data.demo;
---

<Projects>
	<div transition:animate="none">
		<ProjectModal {...data as object} client:load>
			{visible && <div class="flex mb-1 gap-4">
				{data.sourceCode && <a href={data.sourceCode} class="text-sm btn btn-secondary rounded-full font-normal py-0">View source code</a>}
				{data.demo && <a href={data.demo} class="text-sm btn btn-secondary rounded-full font-normal py-0">View demo</a>}
			</div>}
		</ProjectModal>
	</div>
</Projects>
