---
import { getCollection, getEntries } from "astro:content";
import Projects from "../projects.astro";
import ProjectModal from "../../components/ProjectModal.svelte";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;
const visible = data.sourcecode || data.demo || data.languages;
const languages = data.languages && (await getEntries(data.languages));
---

<Projects>
	<div transition:animate="none">
		<ProjectModal {...data as object} client:load>
			{
				visible && (
					<div class="flex mb-1 gap-2">
						{languages &&
							languages.map((language) => (
								<div class="text-sm px-2 bg-neutral-100/15 border-t border-white/25 rounded-full font-normal flex items-center">
									<Icon
										name={language.data.icon}
										aria-label={language.data.name}
										class="mr-1"
									/>
									{language.data.name}
								</div>
							))}
						{data.sourcecode && (
							<a
								href={data.sourcecode}
								class="text-sm btn btn-secondary rounded-full font-normal py-0"
							>
								View source code
							</a>
						)}
						{data.website && (
							<a
								href={data.website}
								class="text-sm btn btn-primary rounded-full font-normal py-0"
							>
								View website
							</a>
						)}
						{data.demo && (
							<a
								href={data.demo}
								class="text-sm btn btn-secondary rounded-full font-normal py-0"
							>
								View demo
							</a>
						)}
					</div>
				)
			}
		</ProjectModal>
	</div>
</Projects>
