---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import htmlCertificate from "../imgs/certificates/html-certification.jpg";
---


<Layout title="Certifications | Blaine's Portfolio">
	<div class="h-full">
		<div class="flex h-full gap-4 items-center justify-center">
			<Image
			src={htmlCertificate}
			alt="HTML Certificate"
			class="rounded-lg border-t border-white/25 shadow-lg shadow-black/85 w-full max-w-lg mx-auto mt-4"
			loading="lazy"
			decoding="async"
			width="800"
			height="600"
			loading="lazy"
			decoding="async"
			alt="HTML Certification"
			/>
		</div>
		<h3 class="text-center text-white/30 mt-2 font-bold">More Certifications to Come...</h3>
	</div>
</Layout>
