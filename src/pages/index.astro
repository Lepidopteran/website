---
import Layout from "../layouts/Layout.astro";
import BowlOfSoup from "../components/BowlOfSoup.astro";
import TerminalCard from "../components/TerminalCard.astro";
import SkillCard from "../components/SkillCard.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import blaine from "../imgs/blaine.png";

import { getCollection } from "astro:content";
const projects = await getCollection("projects", ({ data }) => data.featured);
const languages = await getCollection(
	"programming-languages",
	({ data }) => data.featured,
);

const technologies = await getCollection(
	"technologies",
	({ data }) => data.featured,
);

const tools = await getCollection("software", ({ data }) => data.featured);
---

<Layout title="Blaine's Portfolio">
	<div slot="background" class="h-1/4 relative w-full text-neutral-50/5">

    <div class="background-grid">
      <div class="background-grid blur-sm"></div>
    </div>
    <div class="bg-gradient-to-t from-neutral-900 absolute h-full w-full">
    </div>
  </div>

	<div slot="background" class="h-1/4 w-full text-neutral-50/25 relative">
    <div class="bg-gradient-to-b from-neutral-900 via-transparent to-neutral-900 to size-full absolute"></div>
		<div class="size-full background-dot-grid bg-neutral-900"></div>
  </div>

	<div slot="background" class="h-1/4 w-full text-neutral-50/25 bg-neutral-900 relative flex justify-center items-center overflow-hidden">
		<div class="absolute size-full noise bg-neutral-900/50"></div>
		<div class="size-[240px] absolute left-1/2 top-1/2 -translate-y-1/2 -translate-x-1/2 blur-[100px]">
			<div class="size-full bg-primary-600 rounded-full absolute translate-y-64"></div>
			<div class="size-full bg-accent-600 rounded-full absolute -translate-x-64"></div>
			<div class="size-full bg-secondary-400 rounded-full absolute translate-x-64"></div>
		</div>
    <div class="bg-gradient-to-b from-neutral-900 from-10% via-50% via-transparent to-neutral-900 to-90% size-full absolute"></div>
		<svg>
			<defs>
				<filter id="noise">
					<feTurbulence
						type="fractalNoise"
						baseFrequency="0.5"
						numOctaves="2"
						result="warp"
					/>
					<feComposite in="SourceGraphic" in2="warp" operator="out" />
				</filter>
			</defs>
		</svg>
  </div>

  <div slot="background" class="h-full w-full text-neutral-50/5 relative">
    <div class="bg-gradient-to-b to-neutral-950 from-10% from-neutral-900 h-full w-full"></div>
  </div>

  <section
    class="grid sm:grid-cols-2 sm:auto-rows-min items-center justify-items-center my-8 relative px-4 gap-6"
  >
    <Image
      src={blaine}
      class="rounded-xl border-t object-cover h-full max-sm:w-full border-white/50 max-h-fit sm:row-span-full shadow-lg w-96 justify-self-center shadow-neutral-950"
      alt="Blaine Nicholls"
    />
    <div class="grid grid-cols-1 gap-3">
      <hgroup class="font-redhat col-start-1 mb-4 inline-flex flex-col">
				<div class="relative inline-block">
					<h1 class="text-4xl col-start-1 col-end-2 row-start-1 font-bold relative">
						Blaine Nicholls
					</h1>
					<div class="relative -bottom-2">
						<div class="h-1.5 px-4 bg-gradient-to-r from-primary-500 to-secondary-300 rounded-full"></div>
						<div class="h-1.5 px-4 bg-gradient-to-r from-primary-500 to-secondary-300 rounded-full blur-md"></div>
					</div>
				</div>
        <p class="text-xl text-center leading-6 mt-4 text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-secondary-300">Software Engineer | Full-Stack Developer | Computer Nerd</p>
      </hgroup>
			<TerminalCard class="col-start-1 border-t border-accent-200/25 shadow-md shadow-black/85">
        <pre
          slot="body">
        (
      )    )
   _.(--"("""--.._
  /, _..-----).._,\
 |  `'''-----'''`  |
  \               /
   '.           .'
     '--.....--'

    Soup is Good!</pre>
      </TerminalCard>
      <div class="space-y-2 col-start-1">
				<div class="shadow-md shadow-neutral-950 border-t border-white/25 bg-neutral-800 max-w-3xl rounded-xl p-4 mt-4">
					<h3 class="text-xl font-bold opacity-50">About Me</h3>
					<div class="max-w-[50ch] text-balance text-lg leading-6 margin-auto">
						<p class="text-pretty mt-2 whitespace-pre-line">Hi, I'm Blaine,

							I build websites & software.
							I also create 3D models, music, and animations.

							Interests and proficiencies:
						</p>
						<ul class="list-disc px-6">
							<li>
								Machine Learning
							</li>
							<li>
								Web/Software Development
							</li>
							<li>
								Data Visualization
							</li>
							<li>
								UI/UX Design
							</li>
							<li>
								3D Modelling
							</li>
						</ul>
					</div>
				</div>
      </div>
    </div>
  </section>
	<section class="space-y-6 px-4">
		<div class="flex gap-2">
		</div>
	</section>

	<h4 class="my-3 ml-6">Operating Systems</h4>

	<div role="tablist" class="flex max-md:flex-col gap-x-8 gap-y-8 mb-4 px-8 py-4 justify-center items-start">
		<input
		type="radio"
		role="tab"
		class="peer/linux sr-only"
		tabindex="0"
		checked="true"
		id="OperatingSystemLinuxRadio"
		name="OperatingSystemInput"
		/>
		<input
		type="radio"
		role="tab"
		class="peer/windows sr-only"
		tabindex="0"
		id="OperatingSystemWindowsRadio"
		name="OperatingSystemInput"
		/>
		<div
			id="OperatingSystemCardGroup"
			class="flex sm:justify-center gap-8 md:gap-4 col-span-2"
			>
			<div
				id="OperatingSystemLinuxCard"
				class="flex flex-col items-center gap-3 bg-gradient-to-t from-neutral-900 transition translate-y-0 backdrop-blur rounded-lg border-t border-white/25 shadow-md shadow-black/85 border-opacity-40 p-4 box-border justify-self-end relative"
				>
				<Icon class="h-32 w-32" name="linux" />
				<span class="font-bold">Linux</span>
				<label
					for="OperatingSystemLinuxRadio"
					tabindex="-1"
					title="Interactive Linux operating system card"
					class="absolute top-0 right-0 w-full h-full cursor-pointer"></label>
			</div>
			<div
				id="OperatingSystemWindowsCard"
				class="flex flex-col transition items-center gap-4 bg-gradient-to-t from-neutral-900 backdrop-blur rounded-lg shadow-md shadow-black/85 border-t border-neutral-700 p-4 box-border justify-self-start relative"
				>
				<Icon class="h-32 w-32 text-cyan-500" name="simple-icons:windows" />
				<span class="font-bold">Windows</span>
				<label
					for="OperatingSystemWindowsRadio"
					tabindex="-1"
					title="Interactive Windows operating system card"
					class="absolute top-0 right-0 w-full h-full cursor-pointer"></label>
			</div>
		</div>
		<p
			role="tabpanel"
			aria-labelledby="OperatingSystemLinuxRadio"
			class="hidden text-pretty text-lg peer-checked/linux:block bg-neutral-800 max-w-[50ch] p-4 rounded-xl shadow-md shadow-black/85 border-t border-white/25"
			>
			For the past {new Date().getFullYear() - 2019} years now, my primary operating
			system has been Linux, which I use for both development and personal tasks.
			I've experimented with a couple of distros but have currently settled on
			<a
				class="underline underline-offset-2 opacity-80"
				href="https://fedoraproject.org/">Fedora</a
			>, although I also have experience using <a
				class="underline underline-offset-2 opacity-80"
				href="https://www.debian.org/">Debian</a
			>, <a
				class="underline underline-offset-2 opacity-80"
				href="https://ubuntu.com/">Ubuntu</a
			>, and <a
				class="underline underline-offset-2 opacity-80"
				href="https://archlinux.org/">Arch</a
			>.
		</p>
		<p
			role="tabpanel"
			aria-labelledby="OperatingSystemWindowsRadio"
			class="hidden text-pretty text-lg peer-checked/windows:block bg-neutral-800 max-w-[50ch] p-4 rounded-xl shadow-md shadow-black/85 border-t border-white/25"
			>
			I have significant experience with Windows, particularly Windows 10 and Windows 11, for a variety of tasks. While it is not my primary operating system, I have gained proficiency in utilizing their features, showcasing my adaptability and technical skills across these versions.
		</p>
	</div>
	<section class="px-4 lg:px-8">
		<h3 class="font-bold text-3xl text-center">Skills</h3>
			<div class="flex flex-col md:flex-row gap-4 mt-4">
				<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-900">
					<h4>Languages</h4>
					<div
						class="grid grid-cols-4 gap-4"
						>
					{ languages.map(language => (
						language.data.url ? (
						<SkillCard
						name={language.data.name}
						size="64"
						link={language.data.url}
						icon={language.data.icon}
						/>
						) :	
						<SkillCard
						name={language.data.name}
						size="64"
						icon={language.data.icon}
						/>
					))}
					</div>
				</div>
				<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-900">
				<h4>Technologies</h4>

					<div
						class="grid grid-cols-3 md:grid-cols-4 justify-items-center gap-4"
						>
						{ technologies.map(technology => (
						<SkillCard
						name={technology.data.name}
						size="64"
						link={technology.data.url}
						icon={technology.data.icon}
						/>
						))}
					</div>
				</div>
			</div>
			<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800 to-neutral-900 mt-4">
			<h4>Tools</h4>
				<div
					class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-4"
					>
					{ tools.map(tool => (
						<SkillCard
						name={tool.data.name}
						size="64"
						link={tool.data.url}
						icon={tool.data.icon}
						/>
					))}
				</div>

			</div>
	</section>
	<section class="mt-6">
		<h3 class="font-bold text-3xl text-center">
			Projects I've Worked On
		</h3>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 px-4 pt-4">
			{ projects.map((project) => (
			<a href=`/projects/${project.id}`} class="hover:shadow-lg hover:shadow-primary-600/10 rounded-lg transition duration-75 block md:h-48 overflow-visible">
				<div class="grid h-full sm:grid-cols-2 justify-items-center gap-4 items-center justify-around px-4 bg-gradient-to-b from-neutral-800/85 to-neutral-900/85 shadow-inner shadow-white/25 p-4 border-t border-white/25 rounded-lg overflow-hidden">
						<img 
							src={project.data.thumbnail} 
							alt={project.data.title} 
							class="rounded-lg border-t border-white/25 object-cover shadow-md shadow-black/85"
							loading="lazy"
							decoding="async"
						/>
					<div class="flex flex-col h-full">
						<h4 class="text-2xl font-bold">{project.data.title}</h4>
						<p class="text-pretty line-clamp-4">{project.data.description}</p>
					</div>
				</div>
			</a>
			))}
		</div>
	</section>
	<div class="flex flex-col items-center justify-center mt-24">
		<p class="font-light text-2xl">You've reached the end...</p>
		<p class="font-light text-2xl mb-4">Have a bowl of soup</p>
		<BowlOfSoup class="relative size-24 top-[3px]" />
	</div>
</Layout>


<style>


h4 {
	font-size: var(--text-xl);
}

#OperatingSystemLinuxRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemLinuxCard,
#OperatingSystemWindowsRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard {
	shadow: inset 0 -1px 0 0 rgba(0, 0, 0, 0.25);
	background-color: var(--color-neutral-800);
}

#OperatingSystemLinuxRadio:not(:checked)
~ #OperatingSystemCardGroup
#OperatingSystemLinuxCard:hover,
#OperatingSystemWindowsRadio:not(:checked)
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard:hover {
	scale: 1.05;
}

#OperatingSystemWindowsRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard {
	background-color: var(--color-neutral-600);
}

#radialBg {
	background-image: radial-gradient(
		circle at bottom,
		rgba(82, 82, 82, 0.5) 25%,
		transparent 50%
		);
}

.background-grid {
	--grid-size: 35px;
	--grid-width: 97%;
	background-image: linear-gradient(
		transparent var(--grid-width),
		var(--grid-color, currentColor) var(--grid-width)
		),
		linear-gradient(
		90deg,
		transparent var(--grid-width),
		var(--grid-color, currentColor) var(--grid-width)
		);
	background-size: var(--grid-size) var(--grid-size);
	@apply absolute w-full h-full bg-center -z-[1];
}

.background-dot-grid {
	background-image: radial-gradient(currentColor 1px, transparent 0);
  background-size: 40px 40px;
  background-position: -19px -19px;
}

.noise {
	filter: url(#noise);
}
</style>
