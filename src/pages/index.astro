---
import Layout from "../layouts/Layout.astro";
import AlbumCard from "../components/AlbumCard.svelte";
import TerminalCard from "../components/TerminalCard.astro";
import SkillCard from "../components/SkillCard.astro";
import Card from "../components/Card.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import blaine from "../imgs/blaine.png";
import htmlCertificate from "../imgs/certificates/html-certification.jpg";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

---

<Layout title="Blaine's Portfolio">
  <div slot="background" class="h-svh relative w-full text-neutral-50/5">

    <div class="background-grid">
      <div class="background-grid blur-sm"></div>
    </div>
    <div class="bg-gradient-to-t from-neutral-900 absolute h-full w-full">
    </div>
  </div>
  <div slot="background" class="h-svh w-full text-neutral-50/5">
    <div class="bg-gradient-to-b from-neutral-900 from-25% to-neutral-900 h-full w-full"></div>
  </div>
  <div slot="background" class="h-full w-full text-neutral-50/5">
    <div class="bg-gradient-to-b to-neutral-950 from-25% from-neutral-900 h-full w-full"></div>
  </div>

  <section
    class="grid sm:grid-cols-2 sm:auto-rows-min items-center justify-items-stretch max-w-screen-xl w-full my-8 gap-8 relative px-4"
  >
    <Image
      src={blaine}
      class="rounded-xl border-t object-cover h-full max-sm:w-full sm:col-start-2 border-white/50 max-h-fit sm:row-span-full shadow-lg shadow-neutral-950"
      alt="Blaine Nicholls"
    />
    <div class="grid grid-cols-1 gap-3">
      <hgroup class="font-redhat col-start-1 mb-4 inline-flex flex-col">
				<div class="relative inline-block">
					<div>
						<div class="absolute -bottom-2 left-0 w-full h-1.5 px-4 pr-72 bg-gradient-to-r from-emerald-300 to-pink-500 rounded-full"></div>
						<div class="absolute -bottom-2 left-0 w-full h-1.5 px-4 pr-72 bg-gradient-to-r from-emerald-300 to-pink-500 rounded-full blur-md"></div>
					</div>
					<h1 class="text-4xl col-start-1 col-end-2 row-start-1 font-bold relative">
						Blaine Nicholls
					</h1>
				</div>
        <p class="text-xl leading-6 mt-4 text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-pink-600 inline-block">Computer Nerd</p>
      </hgroup>
			<TerminalCard class="col-start-1 border-t border-white/25 shadow-md shadow-black/85">
        <pre
          slot="body">
        (
      )    )
   _.(--"("""--.._
  /, _..-----).._,\
 |  `'''-----'''`  |
  \               /
   '.           .'
     '--.....--'

    Soup is Good!</pre>
      </TerminalCard>
      <div class="space-y-2 col-start-1">
        <h3 class="text-xl font-bold">
          Most Listened to Album This Week
        </h3>
        <AlbumCard client:visible />
      </div>
    </div>
  </section>
	<section class="space-y-6 px-4">
		<div class="flex gap-2">
			<div class="shadow-md shadow-neutral-950 border-t border-white/25 bg-neutral-800 max-w-3xl rounded-xl p-4 mt-4">
				<h3 class="text-xl font-bold opacity-50">About Me</h3>
				<p class="text-pretty mt-2 text-lg">
					Hey there! I'm Blaine, I love to code websites and applications.
					I also can create 3D models, animations, and music.
					I have a sarcastic and often dark sense of humor, and I love to make people laugh.
					I'm always looking for new projects to work on, so if you have an idea, feel free to reach out! 
				</p>
			</div>
		</div>
	</section>

	<h4 class="my-3 ml-6">Operating Systems</h4>

	<div role="tablist" class="flex max-md:flex-col gap-x-8 gap-y-8 mb-4 px-8 py-4 justify-center items-start">
		<input
		type="radio"
		role="tab"
		class="peer/linux sr-only"
		tabindex="0"
		checked="true"
		id="OperatingSystemLinuxRadio"
		name="OperatingSystemInput"
		/>
		<input
		type="radio"
		role="tab"
		class="peer/windows sr-only"
		tabindex="0"
		id="OperatingSystemWindowsRadio"
		name="OperatingSystemInput"
		/>
		<div
			id="OperatingSystemCardGroup"
			class="flex sm:justify-center gap-8 md:gap-4 col-span-2"
			>
			<div
				id="OperatingSystemLinuxCard"
				class="flex flex-col items-center gap-3 bg-gradient-to-t from-neutral-900 transition translate-y-0 backdrop-blur rounded-lg border-t border-white/25 shadow-md shadow-black/85 border-opacity-40 p-4 box-border justify-self-end relative"
				>
				<Icon class="h-32 w-32" name="linux" />
				<span class="font-bold">Linux</span>
				<label
					for="OperatingSystemLinuxRadio"
					tabindex="-1"
					title="Interactive Linux operating system card"
					class="absolute top-0 right-0 w-full h-full cursor-pointer"></label>
			</div>
			<div
				id="OperatingSystemWindowsCard"
				class="flex flex-col transition items-center gap-4 bg-gradient-to-t from-neutral-900 backdrop-blur rounded-lg shadow-md shadow-black/85 border-t border-neutral-700 p-4 box-border justify-self-start relative"
				>
				<Icon class="h-32 w-32 text-cyan-500" name="simple-icons:windows" />
				<span class="font-bold">Windows</span>
				<label
					for="OperatingSystemWindowsRadio"
					tabindex="-1"
					title="Interactive Windows operating system card"
					class="absolute top-0 right-0 w-full h-full cursor-pointer"></label>
			</div>
		</div>
		<p
			role="tabpanel"
			aria-labelledby="OperatingSystemLinuxRadio"
			class="hidden text-pretty text-lg peer-checked/linux:block bg-neutral-800 max-w-xl p-4 rounded-xl shadow-md shadow-black/85 border-t border-white/25"
			>
			For the past {new Date().getFullYear() - 2019} years now, my primary operating
			system has been Linux, which I use for both development and personal tasks.
			I've experimented with a couple of distros but have currently settled on
			<a
				class="underline underline-offset-2 opacity-80"
				href="https://fedoraproject.org/">Fedora</a
			>, although I also have experience using <a
				class="underline underline-offset-2 opacity-80"
				href="https://www.debian.org/">Debian</a
			>, <a
				class="underline underline-offset-2 opacity-80"
				href="https://ubuntu.com/">Ubuntu</a
			>, and <a
				class="underline underline-offset-2 opacity-80"
				href="https://archlinux.org/">Arch</a
			>.
		</p>
		<p
			role="tabpanel"
			aria-labelledby="OperatingSystemWindowsRadio"
			class="hidden text-pretty text-lg peer-checked/windows:block bg-neutral-800 max-w-xl p-4 rounded-xl shadow-md shadow-black/85 border-t border-white/25"
			>
			I have significant experience with Windows, particularly Windows 10 and Windows 11, for a variety of tasks. While it is not my primary operating system, I have gained proficiency in utilizing their features, showcasing my adaptability and technical skills across these versions.
		</p>
	</div>
	<section class="px-4 lg:px-8">
		<h3 class="font-bold text-3xl text-center">Skills</h2>
			<div class="flex flex-col md:flex-row gap-4 mt-4">
				<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800">
					<h4>Languages</h4>
					<div
						class="grid grid-cols-3 gap-4"
						>
						<SkillCard
						name="Javascript"
						size="64"
						link="https://developer.mozilla.org/en-US/docs/Web/JavaScript"
						iconClassName="text-yellow-400"
						icon="simple-icons:javascript"
						/>
						<SkillCard
						name="Typescript"
						size="64"
						link="https://www.typescriptlang.org/"
						iconClassName="text-blue-500"
						icon="simple-icons:typescript"
						/>
						<SkillCard
						name="Rust"
						size="64"
						link="https://www.rust-lang.org/"
						iconClassName="text-neutral-200"
						icon="simple-icons:rust"
						/>
						<SkillCard
						name="DotNet"
						size="64"
						link="https://dotnet.microsoft.com/en-us/"
						icon="logos:dotnet"
						/>
						<SkillCard
						name="Python"
						size="64"
						link="https://www.python.org/"
						icon="devicon:python"
						/>
						<SkillCard
						name="GDScript"
						size="64"
						link="https://godotengine.org/"
						icon="logos:godot-icon"
						/>
					</div>

				</div>
				<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800">

				<h4>Technologies</h4>

					<div
						class="grid grid-cols-3 md:grid-cols-4 justify-items-center gap-4"
						>
						<SkillCard
						name="TailwindCSS"
						size="64"
						link="https://tailwindcss.com/"
						icon="logos:tailwindcss-icon"
						/>
						<SkillCard
						name="React"
						size="64"
						link="https://reactjs.dev/"
						icon="logos:react"
						/>
						<SkillCard
						name="Svelte"
						size="64"
						link="https://svelte.dev/"
						icon="logos:svelte-icon"
						/>
						<SkillCard
						name="Astro"
						size="64"
						link="https://astro.build/"
						icon="simple-icons:astro"
						/>
						<SkillCard
						name="Docker"
						size="64"
						iconClassName="text-sky-500"
						link="https://www.docker.com/"
						icon="simple-icons:docker"
						/>
						<SkillCard
						name="Web Components"
						size="64"
						link="https://developer.mozilla.org/en-US/docs/Web/Web_Components"
						icon="mdi:application-brackets-outline"
						/>
						<SkillCard
						name="Tauri"
						size="64"
						link="https://tauri.studio/"
						icon="logos:tauri"
						/>
					</div>
				</div>
			</div>
			<div class="shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800 mt-4">
			<h4>Tools</h4>
				<div
					class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-4"
					>
					<SkillCard
					name="VSCode"
					size="64"
					link="https://code.visualstudio.com/"
					iconClassName="text-blue-500"
					icon="logos:visual-studio-code"
					/>
					<SkillCard
					name="Visual Studio"
					size="64"
					link="https://visualstudio.microsoft.com/"
					icon="logos:visual-studio"
					/>
					<SkillCard
					name="NeoVim"
					size="64"
					link="https://neovim.io/"
					icon="devicon:neovim"
					/>
					<SkillCard
					name="Git"
					size="64"
					link="https://git-scm.com/"
					icon="logos:git-icon"
					/>
					<SkillCard
					name="Blender"
					size="64"
					link="https://www.blender.org/"
					icon="logos:blender"
					/>
					<SkillCard
					name="Godot"
					size="64"
					link="https://godotengine.org/"
					icon="logos:godot-icon"
					/>
					<SkillCard
					name="Gimp"
					size="64"
					link="https://www.gimp.org/"
					icon="devicon:gimp"
					/>
					<SkillCard
					name="Inkscape"
					size="64"
					link="https://inkscape.org/"
					icon="devicon:inkscape"
					/>
				</div>
			</div>
	</section>
	<section class="mt-8">
		<h3 class="font-bold text-3xl text-center">
			Certifications
		</h3>
		<div class="flex gap-4 items-center justify-center">
			<Image
			src={htmlCertificate}
			alt="HTML Certificate"
			class="rounded-lg border-t border-white/25 shadow-lg shadow-black/85 w-full max-w-lg mx-auto mt-4"
			loading="lazy"
			decoding="async"
			width="800"
			height="600"
			loading="lazy"
			decoding="async"
			alt="HTML Certification"
			/>

		</div>
		<h4 class="text-center text-white/30 mt-2">More Certifications to Come...</h4>
	</section>
	<section class="mt-6">
		<h3 class="font-bold text-3xl text-center">
			Featured Projects
		</h3>
		<div class="max-w-4xl w-screen m-auto">
			{ projects.map((project) => {
			if (project.data.featured) {
			return <div class="flex even:flex-row-reverse gap-4 items-start justify-between mt-8 px-4">
				<img 
					src={project.data.thumbnail} 
					alt={project.data.title} 
					class="rounded-lg border-t border-white/25 shadow-lg shadow-black/85 max-w-xl w-1/2 object-cover"
					loading="lazy"
					decoding="async"
				/>
				<div class="w-96">
					<h4 class="text-2xl font-bold">{project.data.title}</h4>
					<p class="text-pretty">{project.data.description}</p>
				</div>
			</div>
			}
			}
			)}
	</section>
</Layout>

<style>

.dialog:target {
	display: flex;
}

h4 {
	@apply font-bold text-xl;
}

#OperatingSystemLinuxRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemLinuxCard,
#OperatingSystemWindowsRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard {
	@apply animate-float shadow-lg shadow-black/85 bg-neutral-800;
}

#OperatingSystemLinuxRadio:not(:checked)
~ #OperatingSystemCardGroup
#OperatingSystemLinuxCard:hover,
#OperatingSystemWindowsRadio:not(:checked)
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard:hover {
	@apply transform hover:scale-105;
}

#OperatingSystemWindowsRadio:checked
~ #OperatingSystemCardGroup
#OperatingSystemWindowsCard {
	@apply border-neutral-600;
}

#radialBg {
	background-image: radial-gradient(
		circle at bottom,
		rgba(82, 82, 82, 0.5) 25%,
		transparent 50%
		);
}

.background-grid {
	--grid-size: 35px;
	--grid-width: 97%;
	background-image: linear-gradient(
		transparent var(--grid-width),
		var(--grid-color, currentColor) var(--grid-width)
		),
		linear-gradient(
		90deg,
		transparent var(--grid-width),
		var(--grid-color, currentColor) var(--grid-width)
		);
	background-size: var(--grid-size) var(--grid-size);
	@apply absolute w-full h-full bg-center -z-[1];
}
</style>
