---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";

const projects = await getCollection("projects");
---

<Layout title="Projects">
	<ClientRouter slot="head" />
	<div slot="background" class="size-full bg-neutral-900 noise">
		<svg aria-hidden="true">
			<defs>
				<filter id="noise">
					<feTurbulence
						type="fractalNoise"
						baseFrequency="0.5"
						numOctaves="2"
						result="warp"></feTurbulence>
					<feComposite in="SourceGraphic" in2="warp" operator="out"
					></feComposite>
				</filter>
			</defs>
		</svg>
	</div>
	<div class="px-4">
		<slot />
	</div>
	<section id="projects" class="p-4">
		<h2 class="text-center text-3xl font-bold text-neutral-100 m-4">
			Software Projects
		</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
			{
				projects.map((project) => {
					return (
						<a
							class="hover:scale-105 hover:shadow-lg transition duration-75 h-full"
							href={`/projects/${project.id}`}
						>
							<div
								class="bg-neutral-900 h-full shadow-md shadow-black/85 p-4 rounded-lg border-t border-white/25 bg-gradient-to-b from-neutral-800"
								id={project.id}
							>
								<img
									src={project.data.thumbnail}
									class="rounded-lg border-t border-white/25 h-48 object-cover shadow-md shadow-black/25 inline-block"
									alt={project.data.title}
								/>
								<h4 class="text-xl font-bold mt-4">{project.data.title}</h4>
								<p class="mt-2">{project.data.description}</p>
							</div>
						</a>
					);
				})
			}
		</div>
	</section>

	<span class="text-xl font-bold mt-4 text-center block"
		>And more to come...</span
	>

	<style>
		.noise {
			filter: url(#noise);
		}
	</style>
</Layout>
