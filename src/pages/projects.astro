---
import View from "../components/ProjectView.svelte";
import NoJavascriptSection from "../components/NoJavascriptSection.astro";
import NoJavascriptWarning from "../components/NoJavascriptWarning.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";

const projectCollection = await getCollection("projects");

projectCollection.sort((a, b) => {
	return b.data.created?.getTime() - a.data.created?.getTime();
});

const projects = projectCollection.map((project) => {
	return {
		id: project.id,
		...project.data,
	};
});
---

<Layout title="Projects">
	<ClientRouter slot="head" />
	<div slot="background" class="size-full bg-neutral-900 noise">
		<svg aria-hidden="true">
			<defs>
				<filter id="noise">
					<feTurbulence
						type="fractalNoise"
						baseFrequency="0.5"
						numOctaves="2"
						result="warp"></feTurbulence>
					<feComposite in="SourceGraphic" in2="warp" operator="out"
					></feComposite>
				</filter>
			</defs>
		</svg>
	</div>
	<div class="px-4">
		<slot />
	</div>
	<div class="py-4">
		<NoJavascriptWarning />
	</div>
	<div class="px-4">
		<h2 class="text-center text-3xl font-bold text-neutral-100 m-4">
			Software Projects
		</h2>
		<View {projects} />
	</div>

	<style>
		.noise {
			filter: url(#noise);
		}
	</style>
</Layout>
